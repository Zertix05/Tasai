# Frontend (optional). Default: /api/amocrm.php
VITE_AMOCRM_ENDPOINT=/api/amocrm.php

# Server secrets — предпочтительно public/api/amocrm.secrets.php
# (скопируйте из amocrm.secrets.example.php). Ниже — альтернатива через env хостинга:
# AMOCRM_SUBDOMAIN=your_subdomain
# AMOCRM_ACCESS_TOKEN=your_long_lived_token
# AMOCRM_BASE_DOMAIN=amocrm.ru
# AMOCRM_PHONE_FIELD_ID=
# AMOCRM_PIPELINE_ID=
# AMOCRM_STATUS_ID=
# AMOCRM_ALLOWED_ORIGIN=
